NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
INFRAGREEN_ADMIN_EMAILS=admin@example.com,founder@infragreen.com
# Cloudflare Turnstile (bot protection for the public forms).
# If unset, the widget is hidden and server verification is skipped with a warning.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
